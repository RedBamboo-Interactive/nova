[
  {
    "typeSlug": "node-type",
    "slug": "nova-session",
    "name": "Nova Session",
    "data": {
      "icon": "ph-bold ph-star",
      "category": "ai",
      "description": "Runs an agent session with Nova discussion delivery and an auditable child Compute job.",
      "input_ports": [
        { "id": "prompt", "type": "string", "label": "Prompt" }
      ],
      "output_ports": [
        { "id": "summary", "type": "string", "label": "Summary" },
        { "id": "sessionId", "type": "string", "label": "Session" },
        { "id": "discussionId", "type": "string", "label": "Discussion" }
      ],
      "config_schema": {
        "type": "object",
        "required": ["source_automation_id", "automation_name", "prompt"],
        "properties": {
          "source_automation_id": { "type": "string", "description": "Stable source automation identity used for provenance and idempotency." },
          "automation_slug": { "type": "string" },
          "automation_name": { "type": "string" },
          "agent": { "type": "string", "description": "Agent entity id or slug." },
          "prompt": { "type": "string", "widget": "textarea" },
          "report_to_discussion_id": { "type": "string" },
          "action_config": { "type": "object", "widget": "json" }
        }
      }
    }
  },
  {
    "typeSlug": "node-type",
    "slug": "heartbeat-tick",
    "name": "Heartbeat Tick",
    "data": {
      "icon": "ph-bold ph-heartbeat",
      "category": "agent",
      "description": "Runs one guarded heartbeat tick for an agent's persistent discussion and session.",
      "input_ports": [
        {
          "id": "quality_tier",
          "label": "Quality Tier",
          "widget": "entity",
          "field_type": "entity_ref",
          "constraints": { "target_type": "quality-tier" },
          "config_path": "action_config",
          "description": "Provider-agnostic quality tier used when creating the heartbeat session."
        },
        {
          "id": "tick_wait_minutes",
          "label": "Tick Wait Minutes",
          "widget": "slider",
          "field_type": "integer",
          "default": 15,
          "minimum": 1,
          "maximum": 60,
          "config_path": "action_config",
          "description": "Maximum minutes to wait for a heartbeat session to become idle."
        },
        {
          "id": "max_turns",
          "label": "Max Turns",
          "widget": "slider",
          "field_type": "integer",
          "default": 15,
          "minimum": 1,
          "maximum": 100,
          "config_path": "action_config",
          "description": "Maximum tool actions requested in one heartbeat turn."
        }
      ],
      "output_ports": [
        { "id": "summary", "type": "string", "label": "Summary" },
        { "id": "sessionId", "type": "string", "label": "Session" },
        { "id": "discussionId", "type": "string", "label": "Discussion" },
        { "id": "silent", "type": "boolean", "label": "Silent" }
      ],
      "config_schema": {
        "type": "object",
        "required": ["source_automation_id", "automation_name", "agent"],
        "properties": {
          "source_automation_id": { "type": "string", "description": "Stable source automation identity used by the agent heartbeat configuration." },
          "automation_slug": { "type": "string" },
          "automation_name": { "type": "string" },
          "agent": { "type": "string", "description": "Agent entity id." },
          "action_config": { "type": "object", "widget": "json" }
        }
      }
    }
  }
]
