{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      // Pin react types to OUR copy for every file in the program, including the
      // link:'d @redbamboo/* sources — otherwise they resolve @types/react from
      // redbamboo-packages' node_modules and TS sees two unrelated type worlds.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src"],
  // Tests run on node:test via `npm test`, outside the browser bundle. Typing
  // them would need @types/node, which also injects Node globals into the app
  // program and changes DOM types such as setTimeout's return. Keep the app
  // program browser-only; the tests assert at runtime.
  "exclude": ["src/**/*.test.ts"]
}
