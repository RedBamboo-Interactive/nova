<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Leaf.Plugins.Nova</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Resolve Leaf.Sdk: an explicit -p:LeafSdkProject=<path> wins, else the kernel
         checkout as a sibling of this repo. The SDK is the hard
         ceiling — plugins never reference the kernel. A published Leaf.Sdk NuGet
         package replaces this probing at M2a. -->
    <LeafSdkProject Condition="'$(LeafSdkProject)' == '' And Exists('..\..\..\leaf-sdk\src\Leaf.Sdk\Leaf.Sdk.csproj')">..\..\..\leaf-sdk\src\Leaf.Sdk\Leaf.Sdk.csproj</LeafSdkProject>
    <LeafSdkProject Condition="'$(LeafSdkProject)' == '' And Exists('..\..\..\redleaf\src\Leaf.Sdk\Leaf.Sdk.csproj')">..\..\..\redleaf\src\Leaf.Sdk\Leaf.Sdk.csproj</LeafSdkProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(LeafSdkProject)" Condition="'$(LeafSdkProject)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <!-- The manifest the loader reads from disk is also the Manifest property this
         assembly exposes — embedding the same file keeps them from drifting. -->
    <EmbeddedResource Include="..\..\plugin.json" LogicalName="plugin.json" />
  </ItemGroup>

</Project>
